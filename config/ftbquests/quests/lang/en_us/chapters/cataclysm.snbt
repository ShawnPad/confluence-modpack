	quest.426E087DF5AC9F9E.quest_desc: ["[CATA.1]", "The Netherite Monstrosity is the boss of L_Ender's Cataclysm Soul Forge, and that structure generates only in the Nether. Kill it once."]
	quest.51B7CA5D3BD490D1.title: "Monstrous Horn"
	quest.51B7CA5D3BD490D1.quest_desc: ["[D1.3]", "The Monstrous Horn is the Netherite Monstrosity's drop and the Twilight key recipe needs one, so this boss is on the critical path."]
