{
	quest.2EC979265124AB1E.title: "Twilight Key"
	quest.2EC979265124AB1E.quest_desc: ["[D2.1]", "The key is crafted from a netherite ingot, an Aether zanite gemstone, a Mekanism advanced control circuit, an Ars Nouveau elemental essence and Cataclysm's Monstrous Horn. Throw it into the portal pool instead of a diamond; the diamond no longer opens anything."]
	quest.34C4DC4DF5B82831.title: "Allthemodium Ore"
	quest.34C4DC4DF5B82831.quest_desc: ["[D2.2]", "Allthemodium spawns only in the Twilight Forest in this pack, in cave-exposed veins. You need a netherite-tier pickaxe to break it."]
	quest.102CA469468F8E1A.title: "Allthemodium Template"
	quest.102CA469468F8E1A.quest_desc: ["[D2.3]", "The template is added to the Twilight stronghold cache loot, so it stays inside the dimension with the ore. Smithing table: netherite gear plus Allthemodium ingots plus this template."]
	quest.41A5B57830B98089.title: "Knightmetal"
	quest.41A5B57830B98089.quest_desc: ["[D2.4]", "Goblin Knights in the Dark Forest's Knight Stronghold drop armor shards; the shards craft into a cluster that smelts into a Knightmetal Ingot. Twilight Forest, unchanged."]
	quest.40CBD13E78A1F42C.title: "Teleport Pad"
	quest.40CBD13E78A1F42C.quest_desc: ["[D2.5]", "Allthemodium's own recipe, unchanged: four Allthemodium nuggets and an ender pearl. It opens the Mining Dimension, the only place Powah uraninite spawns in this pack."]
	quest.315020D6830FCDD8.title: "Dissolution Chamber"
	quest.315020D6830FCDD8.quest_desc: ["[T2.2]", "Rewritten: Industrial Foregoing's chamber keeps its Pity Machine Frame and plastic, and one gold ingot becomes a Mekanism basic control circuit."]
	quest.14BD76FC2D6209A3.title: "Simple Machine Frame"
	quest.14BD76FC2D6209A3.quest_desc: ["[T2.1]", "Rewritten: made in the Dissolution Chamber from a Pity Machine Frame, plastic and latex, with an Ars Nouveau elemental essence in place of one of the two nether bricks."]
	quest.2C69CB63F838AE13.title: "Arcane Anvil"
	quest.2C69CB63F838AE13.quest_desc: ["[M2.1]", "Rewritten: Iron's Spells' anvil now takes an Industrial Foregoing Simple Machine Frame in place of one polished deepslate. Everything else is Iron's default."]
	quest.12BBBE8926B9593C.title: "Source Gem Block"
	quest.12BBBE8926B9593C.quest_desc: ["[M2.2]", "Ars Nouveau, unchanged: an amethyst block imbued with 2,000 Source in the Imbuement Chamber. It feeds the tier-3 ritual brazier and the End focus later."]
	quest.03A64F0DB6424DEE.title: "Storage Terminal"
	quest.03A64F0DB6424DEE.quest_desc: ["[S2.1]", "Rewritten: Tom's terminal now needs an Industrial Foregoing Simple Machine Frame, an Ars Nouveau elemental essence, a Functional Storage drawer controller plus its netherite upgrade, and a Sophisticated Storage chest."]
	quest.3C76069F96AE065B.title: "Spirited Crystal"
	quest.3C76069F96AE065B.quest_desc: ["[X2.1]", "Rewritten: the Energizing Orb now makes Powah's spirited crystal from uraninite instead of an emerald, and uraninite only spawns in the Mining Dimension behind the Teleport Pad."]
	quest.4CAFF05242DE1ACD.title: "Ore Quintupling"
	quest.4CAFF05242DE1ACD.quest_desc: ["[X2.2]", "Audit: Mekanism's 5x slurry chain works on base metals with no restriction, but each tier ore's chain consumes the next tier's material, so it multiplies a tier you already reached and never opens one early."]
	quest.0F7A3CFCC14D5B59.title: "No Tier-Ore Seeds"
	quest.0F7A3CFCC14D5B59.quest_desc: ["[X2.3]", "Audit: Mystical Agriculture ships no seed for Allthemodium, Vibranium, Unobtainium or any planet metal, and none is added here. Its default crops stay as content."]
	quest.5749A4B5622ACD78.title: "No Tier-Ore Bees"
	quest.5749A4B5622ACD78.quest_desc: ["[X2.4]", "Audit: Productive Bees ships no bee for Allthemodium, Vibranium, Unobtainium or any planet metal, and none is added here. The mod stays as content."]
	quest.068239C7E8C67F4C.title: "No Laser-Drilled Debris"
	quest.068239C7E8C67F4C.quest_desc: ["[X2.5]", "Audit: Industrial Foregoing's Laser Drill keeps its base-ore tables, but the ancient debris entry is removed and no tier-ore or planet-metal entry is added. Netherite stays a trip to the Nether."]
	quest.68B9330B6BC20CF4.title: "No Uncrafting"
	quest.68B9330B6BC20CF4.quest_desc: ["[X2.6]", "Audit: the Twilight Forest Uncrafting Table is removed. It could reverse the keys and cross-mod recipes this pack is built on."]
}
